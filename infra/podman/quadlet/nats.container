[Unit]
Description=Inactive Alpha Desk NATS dependency scaffold

[Container]
Image=docker.io/library/nats:2.14.5-alpine@sha256:d4ac35882ac65aff236cd65b9d3fa4d24332c681e1a85f94eedccd3cdd65b1da
Pull=never
ContainerName=alpha-desk-nats
