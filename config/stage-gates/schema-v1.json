{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsitech.ai/schemas/alpha-desk/stage-gate-v1.json",
  "title": "Alpha Desk stage gate configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "schema_path",
    "output_root",
    "builder_report_output_path",
    "whole_gate_timeout_seconds",
    "max_output_bytes",
    "allowed_programs",
    "program_roots",
    "design",
    "builder",
    "comparison",
    "approvals",
    "remote",
    "artifacts",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "schema_path": { "$ref": "#/$defs/repositoryPath" },
    "output_root": {
      "type": "string",
      "pattern": "^target/stage-gates(?:/.*)?$"
    },
    "builder_report_output_path": {
      "type": "string",
      "pattern": "^target/stage-gates/.+"
    },
    "whole_gate_timeout_seconds": { "type": "integer", "minimum": 1 },
    "max_output_bytes": { "type": "integer", "minimum": 24 },
    "allowed_programs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "program_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "object", "commit"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/gitObject" },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["second_builder_report_path"],
      "properties": {
        "second_builder_report_path": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_tool", "tools"],
      "properties": {
        "target_tool": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/builderTool" }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_path",
        "required_roles",
        "gpgv_program",
        "known_limitations",
        "evidence"
      ],
      "properties": {
        "policy_path": { "$ref": "#/$defs/repositoryPath" },
        "required_roles": {
          "type": "array",
          "contains": { "const": "platform-data" },
          "minContains": 1
        },
        "gpgv_program": { "type": "string", "minLength": 1 },
        "known_limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/approvalEvidence" }
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_path", "app_source", "required_checks"],
      "properties": {
        "proof_path": { "$ref": "#/$defs/repositoryPath" },
        "app_source": { "type": "string", "minLength": 1 },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "approvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "statement_path", "signature_path"],
      "properties": {
        "role": { "enum": ["platform-data", "independent"] },
        "statement_path": { "$ref": "#/$defs/repositoryPath" },
        "signature_path": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "builderTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_output_contains": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "producer",
        "target_triple",
        "profile"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "kind": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "target_triple": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "cwd", "timeout_seconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "$ref": "#/$defs/repositoryPath" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "inherit_env": {
          "type": "array",
          "items": {
            "enum": ["PATH", "HOME", "CARGO_HOME", "RUSTUP_HOME", "TMPDIR"]
          }
        }
      }
    }
  }
}
